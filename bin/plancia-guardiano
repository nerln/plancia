#!/usr/bin/env python3
"""Guardiano PreToolUse dei compartimenti (vedi plancia/compartimenti.py).

Hook globale di Claude Code: gira su OGNI strumento di OGNI sessione, e legge
da stdin il JSON dell'hook. Deve essere veloce e non deve mai rompere niente:
qualunque problema (stdin vuoto o non JSON, il pacchetto che non si importa,
un'eccezione) esce 0 senza negare, cioe' "ammesso" (fail-open: un guardiano
guasto non deve bloccare tutte le sessioni). L'unico modo di NEGARE e' la
modalita' `bloccante` di config.json (chiave `guardiano`), con il diniego su
stdout (vedi `compartimenti.uscita_negata`); `spento` (il default) esce subito.

Ma un guasto NON e' silenzioso. Se il pacchetto non parte (un refuso in
`plancia/__init__.py`, un checkout su un ramo senza `compartimenti.py`, un merge
rotto) il guardiano e' spento per tutti, e nessuno lo saprebbe: qui, in
qualunque eccezione, e con il guardiano non `spento` in config, si scrive una
riga `guardiano-non-parte` in `guardiano.log` (solo libreria standard, al
massimo una ogni dieci minuti, come la nota di config illeggibile) e si stampa
su stdout `{"systemMessage": ...}`: il campo che Claude Code mostra
all'utente per qualunque hook (verificato nel binario 2.1.267: schema
`systemMessage`, "Warning message shown to the user"; che la UI lo mostri per un
PreToolUse e' dedotto, non visto). `plancia guardiano --stato` la mostra.

Il pacchetto si carica SENZA mettere la radice del checkout ne' `bin/` sul
`sys.path`, e senza le cartelle di `PYTHONPATH`: un `json.py` in quelle cartelle
non puo' prendere il posto del modulo di sistema (i due percorsi del checkout sono
anche fra i file protetti; `PYTHONPATH` e `PLANCIA_HOME` in un `env` di settings
sono negati da `_controlla_settings`).

Non resta mai appeso e non muore in silenzio: un allarme interno (`_TEMPO_MAX`,
due secondi) e la cattura di `BaseException` (un `sys.exit(0)` dentro il modulo, un
`KeyboardInterrupt`) portano allo stesso esito di ogni guasto: uscita 0, riga
`guardiano-non-parte`, `systemMessage`. Non si prende `os._exit`, ne' un ciclo in
codice C che non guarda i segnali (dichiarato).

L'allarme che scatta MENTRE il guardiano decide (un comando troppo complesso da
controllare in tempo, per esempio `$(` annidati) non e' un guasto: e' un comando che
non si e' potuto controllare, e `compartimenti.uscita_tempo_scaduto` decide. Un
nominato (o una sessione incerta) in `bloccante`, GIA' STABILITO come tale, e' NEGATO con
il motivo "comando troppo complesso da controllare in tempo: spezzalo"; il predefinito e'
ammesso ma con il `systemMessage` OGNI volta (nessun silenzio dopo la prima); in
`solo-registro` non si nega mai. Se l'allarme scatta prima di sapere a che compartimento
appartiene la sessione (chiamante non ancora stabilito, per esempio un disco fermo mentre
si leggono le cartelle configurate) non e' "incerto": nessuno e' negato, si ammette con il
`systemMessage` e una riga `tempo-scaduto`. Solo un allarme scattato durante il
caricamento del pacchetto (o prima di aver letto la config) resta il guasto di sempre.

Su Windows non fa niente: i compartimenti ragionano su percorsi POSIX (la cartella
di un compartimento, lo specchio delle memorie, i comandi di shell), e un guardiano che
sbaglia in silenzio su `C:/...` e' peggio di uno che dice di non esserci. Esce subito,
senza negare niente e senza caricare il pacchetto, con un `systemMessage` UNA volta per
sessione ("non supportato su Windows"): un file per sessione in
`<dati>/guardiano-windows/`, ripulito dopo una settimana. Vedi
`plancia/piattaforma.compartimenti_supportati`. "Windows" lo dice solo `os.name`:
la variabile `PLANCIA_PIATTAFORMA`, con cui le prove fingono una piattaforma, qui non
conta, perche' chi scrive un `settings.json` la puo' mettere in `env` e spegnerebbe il
guardiano (e' fra le `env` che il guardiano stesso nega di scrivere).

Non installato da questo file: si aggiunge a mano a `settings.json` (matcher
`*`, evento PreToolUse), prima in `solo-registro`.
"""
import os
import sys

_QUI = os.path.dirname(os.path.abspath(__file__))
_QUI_REALE = os.path.dirname(os.path.realpath(__file__))
_RADICE = os.path.dirname(_QUI_REALE)
# la cartella di questo script e' sys.path[0]: fuori, cosi' un file `.py` messo
# accanto non ruba il posto a un modulo di sistema. Fuori anche le cartelle di
# PYTHONPATH: il guardiano usa solo la libreria standard e il proprio pacchetto.
_DA_TOGLIERE = {"", _QUI, _QUI_REALE}
for _p in os.environ.get("PYTHONPATH", "").split(os.pathsep):
    if _p:
        _DA_TOGLIERE.add(_p)
        _DA_TOGLIERE.add(os.path.abspath(_p))
sys.path[:] = [p for p in sys.path if p not in _DA_TOGLIERE]

_DIECI_MINUTI = 600
# Tempo massimo di una chiamata dell'hook, in secondi. Una chiamata normale ne
# prende 0.05: oltre, qualcosa e' appeso (un input patologico, un ciclo) e
# l'hook esce come per ogni guasto invece di bloccare lo strumento.
_TEMPO_MAX = 2.0


class _Scaduto(BaseException):
    """L'allarme interno: e' una BaseException cosi' nessun `except Exception` del
    codice analizzato la inghiotte."""


def _allarme(signum, frame):
    raise _Scaduto("tempo massimo di %.0f s superato" % _TEMPO_MAX)


def _arma():
    try:
        import signal
        signal.signal(signal.SIGALRM, _allarme)
        signal.setitimer(signal.ITIMER_REAL, _TEMPO_MAX)
    except Exception:  # noqa: BLE001 - senza SIGALRM (Windows) si va avanti senza
        pass


def _disarma():
    try:
        import signal
        signal.setitimer(signal.ITIMER_REAL, 0)
    except Exception:  # noqa: BLE001
        pass


def _non_parte(exc, sessione):
    """Best effort, solo libreria standard, mai un'eccezione: la riga nel registro e
    l'avviso all'utente. Niente se il guardiano e' `spento` in config (o non
    c'e' config): un guardiano che non parte ma e' spento non fa danno."""
    try:
        import json
        import time
        dati = os.environ.get("PLANCIA_HOME") or os.path.join(
            os.path.expanduser("~"), ".plancia")
        modo = "?"
        try:
            with open(os.path.join(dati, "config.json"), "r", encoding="utf-8") as f:
                letta = json.load(f)
            m = letta.get("guardiano", "spento") if isinstance(letta, dict) else "?"
            modo = m.strip().lower() if isinstance(m, str) else "?"
        except FileNotFoundError:
            return
        except Exception:  # noqa: BLE001 - config illeggibile: potrebbe essere acceso
            pass
        if modo == "spento":
            return
        marca = os.path.join(dati, "guardiano.non-parte")
        try:
            if time.time() - os.path.getmtime(marca) < _DIECI_MINUTI:
                return
        except OSError:
            pass
        # la cartella dei dati puo' non essere scrivibile (permessi tolti): allora
        # niente riga ne' marca, ma l'avviso all'utente si stampa lo stesso, a
        # ogni chiamata
        try:
            os.makedirs(dati, exist_ok=True)
            with open(marca, "w") as f:
                f.write("")
        except OSError:
            pass
        motivo = "guardiano-non-parte: %s: %s" % (type(exc).__name__, str(exc)[:300])
        log = os.path.join(dati, "guardiano.log")
        try:
            try:
                if os.path.getsize(log) > 5 * 1024 * 1024:
                    os.replace(log, log + ".1")
            except OSError:
                pass
            riga = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                    "modalita": modo, "sessione": sessione, "compartimento": "",
                    "strumento": "", "bersaglio": "", "motivo": motivo,
                    "esito": "guardiano-non-parte"}
            fd = os.open(log, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            try:
                os.write(fd, (json.dumps(riga, ensure_ascii=False) + "\n").encode("utf-8"))
            finally:
                os.close(fd)
        except OSError:
            pass
        sys.stdout.write(json.dumps({"systemMessage": (
            "plancia-guardiano non parte (%s: %s): i compartimenti NON sono protetti "
            "in nessuna sessione finche' non si ripara. Vedi `plancia guardiano "
            "--stato`." % (type(exc).__name__, str(exc)[:200]))}, ensure_ascii=False))
        sys.stdout.flush()
    except Exception:  # noqa: BLE001 - l'avviso non deve rompere l'hook
        pass


def _carica():
    import importlib.util
    cartella = os.path.join(_RADICE, "plancia")
    spec = importlib.util.spec_from_file_location(
        "plancia", os.path.join(cartella, "__init__.py"),
        submodule_search_locations=[cartella])
    modulo = importlib.util.module_from_spec(spec)
    sys.modules["plancia"] = modulo
    spec.loader.exec_module(modulo)
    from plancia import compartimenti
    return compartimenti


def _tempo_scaduto(exc):
    """L'allarme e' scattato MENTRE il modulo decideva (non mentre si caricava): un
    comando troppo complesso da controllare in tempo. Un nominato o una sessione incerta
    in `bloccante`, se gia' stabilito come tale, e' NEGATO (motivo: "spezzalo"); il
    predefinito e un chiamante non ancora stabilito sono ammessi ma con il
    `systemMessage` ogni volta. Torna True se ha gestito il caso (il guardiano girava:
    `compartimenti.uscita_tempo_scaduto`), False se no (allarme durante il caricamento,
    config non ancora letta: e' il guasto di sempre, `_non_parte`)."""
    try:
        modulo = globals().get("compartimenti")
        if modulo is None or not isinstance(exc, _Scaduto):
            return False
        uscita = modulo.uscita_tempo_scaduto(modulo.percorso_dati())
        if uscita is None:
            return False
        if uscita:
            sys.stdout.write(uscita)
            sys.stdout.flush()
        return True
    except BaseException:  # noqa: BLE001 - un guasto qui e' il guasto di sempre
        return False


def _su_windows():
    """Si e' su Windows davvero? Solo `os.name`: mai la variabile `PLANCIA_PIATTAFORMA`,
    che le prove di piattaforma usano per fingere ma che chiunque possa scrivere un
    `settings.json` puo' mettere in `env`: se bastasse, una sessione si spegnerebbe il
    guardiano da sola. Stessa regola di plancia/piattaforma.windows_reale(); il pacchetto
    qui non si importa, quindi la regola vive in due posti."""
    return os.name == "nt"


_UNA_SETTIMANA = 7 * 24 * 3600


def _avviso_windows(testo):
    """Windows: niente guardiano. Scrive il `systemMessage` "non supportato" la
    PRIMA volta che vede una sessione, poi tace. Best effort, mai un'eccezione: se
    non riesce a segnare la sessione (dati non scrivibili) tace, perche' un avviso a
    ogni strumento di ogni sessione e' peggio del silenzio."""
    try:
        import json
        import re
        import time
        sid = ""
        try:
            d = json.loads(testo)
            s = d.get("session_id") if isinstance(d, dict) else ""
            sid = s if isinstance(s, str) else ""
        except Exception:  # noqa: BLE001
            pass
        nome = re.sub(r"[^A-Za-z0-9_-]", "_", sid)[:64] or "senza-sessione"
        dati = os.environ.get("PLANCIA_HOME") or os.path.join(
            os.path.expanduser("~"), ".plancia")
        cartella = os.path.join(dati, "guardiano-windows")
        os.makedirs(cartella, exist_ok=True)
        marca = os.path.join(cartella, nome)
        try:
            fd = os.open(marca, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError:
            return
        os.close(fd)
        # la prima di una sessione nuova: si ripulisce anche (al piu' 500 file)
        try:
            adesso = time.time()
            for vecchio in os.listdir(cartella)[:500]:
                p = os.path.join(cartella, vecchio)
                if vecchio != nome and adesso - os.path.getmtime(p) > _UNA_SETTIMANA:
                    os.remove(p)
        except OSError:
            pass
        sys.stdout.write(json.dumps({"systemMessage": (
            "plancia-guardiano: non supportato su Windows. I compartimenti e il "
            "guardiano ragionano su percorsi POSIX: qui non fanno niente, non nega "
            "nessuno strumento e Plancia mostra tutto a tutte le sessioni. Puoi "
            "togliere l'hook PreToolUse dal settings.json.")}))
        sys.stdout.flush()
    except Exception:  # noqa: BLE001 - l'avviso non deve rompere l'hook
        pass


def _leggi_stdin():
    """Lo stdin come UTF-8 (su Windows, con una pipe, `sys.stdin.read()` userebbe
    cp1252). Un BOM iniziale si toglie. Uno stdin senza `.buffer` si legge com'e'."""
    buffer = getattr(sys.stdin, "buffer", None)
    if buffer is None:
        return sys.stdin.read()
    return buffer.read().decode("utf-8-sig", "replace")


_sessione = ""
if _su_windows():
    try:
        _avviso_windows(_leggi_stdin())
    except BaseException:  # noqa: BLE001 - qui non c'e' niente da rompere
        pass
    sys.exit(0)
try:
    testo = sys.stdin.read()
    _arma()      # il tempo massimo conta dal momento in cui c'e' qualcosa da decidere
    try:
        import json as _json
        _d = _json.loads(testo)
        _s = _d.get("session_id") if isinstance(_d, dict) else ""
        _sessione = _s if isinstance(_s, str) else ""
    except Exception:  # noqa: BLE001
        pass
    compartimenti = _carica()
    uscita = compartimenti.hook(testo, compartimenti.percorso_dati())
    _disarma()
    if uscita:
        sys.stdout.write(uscita)
        sys.stdout.flush()
except BaseException as _exc:  # noqa: BLE001 - un hook globale non rompe una sessione
    _disarma()
    if not _tempo_scaduto(_exc):
        _non_parte(_exc, _sessione)
sys.exit(0)
