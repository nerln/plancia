#!/usr/bin/env python3
"""Hook di sessione: registra l'apertura e la chiusura, e all'apertura passa a
Claude il briefing già pronto.

Deve essere veloce e non deve mai fallire: se qualcosa va storto esce zero e
in silenzio, perché un hook rotto blocca ogni sessione.
"""
import glob
import json
import os
import re
import sys
import time

DATA = os.environ.get("PLANCIA_HOME") or os.path.join(os.path.expanduser("~"), ".plancia")
QUEUE = os.path.join(DATA, "queue", "hooks.jsonl")
BRIEFING = os.path.join(DATA, "briefing.md")
DB = os.path.join(DATA, "plancia.db")
CONFIG = os.path.join(DATA, "config.json")
MAX_CONTEXT = 2600

# Stessa regola di plancia/esclusi._ID_VALIDO: un id di sessione (Claude Code
# o Codex) è un uuid, e un valore con un'altra forma è quasi sempre un refuso
# di chi ha scritto config.json a mano.
_ID_VALIDO = re.compile(
    r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")


# Il modulo dei percorsi del sistema (posixpath o ntpath). Le prove lo sostituiscono
# con ntpath per provare la regola di Windows su un altro sistema.
_P = os.path


def _senza_fine(p):
    """`p` senza il separatore finale, ma la radice resta la radice ("/", "C:\\")."""
    if _P.dirname(p) == p:
        return p
    return p.rstrip(_P.sep + (_P.altsep or "")) or p


def _norma(p):
    """Un percorso come si confronta: senza separatore finale e, su Windows, con
    una sola forma di separatore e le maiuscole tutte uguali. Su macOS e Linux e'
    `p` senza lo slash finale, com'e' sempre stato."""
    if _P.altsep:
        p = _P.normcase(_P.normpath(p))
    return _senza_fine(p)


def _dentro(p, base):
    """`p` e' `base` o sta sotto `base`? Tutti e due gia' passati da `_norma`."""
    if p == base:
        return True
    if _P.dirname(base) == base:  # la radice: tutto quello che comincia cosi'
        return p.startswith(base)
    return p.startswith(base + _P.sep)


def _cartelle_e_sessioni_escluse():
    """Copia minima di plancia/esclusi.carica() + plancia/esclusi.valida():
    questo script non importa il pacchetto plancia (vedi il docstring del
    modulo, "deve essere veloce e non deve mai fallire"), quindi la regola
    vive per forza in due posti. Se una delle due cambia, cambia anche
    l'altra: tools/prove/esclusi.py (_prova_hook_valida_come_esclusi) lancia
    entrambe sullo stesso config.json e fallisce se non sono d'accordo.

    Torna `(cartelle, sessioni, valido)`. Non solleva mai. `valido=True` con
    le liste vuote vuol dire "niente configurato" (config.json assente, o
    assente la chiave): comportamento identico a prima. `valido=False` vuol
    dire che config.json esiste ma non ci si può fidare (non si legge, non è
    JSON, non è un oggetto, una delle due chiavi non è una lista di
    stringhe, una cartella non è assoluta o non esiste o è troppo ampia, un
    id di sessione non ha la forma di un uuid): FAIL-CLOSED, non "niente
    escluso". Un config.json con "cartelle_escluse" scritta come una
    stringa invece che una lista non deve mai tradursi in "via libera a
    tutto" (misurato: iterare una stringa dà dei singoli caratteri come
    "cartelle", e un confronto su quelli non esclude niente di reale). Chi
    chiama, con `valido=False`, non scrive niente in coda: meglio perdere una
    sessione per un giro (il sync la recupera comunque dal transcript, che
    l'hook non tocca) che rischiarne una privata perché la configurazione non
    si è capita.

    Le stesse quattro regole di esclusi.valida() sulle cartelle (assoluta,
    esistente, non '/', non una cartella di sistema di Plancia) e sugli id
    (forma di uuid): un config.json che una CLI accetterebbe e l'hook no (o
    viceversa) è quello che il tester ha trovato la volta scorsa, con l'hook
    che continuava ad applicare in parte una regola che `plancia esclusi`
    aveva appena dichiarato inaffidabile. Non fa invece la «grafia vera» del
    percorso (plancia/esclusi._grafia_vera): quella cammina il filesystem
    componente per componente, e l'hook non deve mai costare più di un paio
    di stat in croce. La differenza pratica è che qui una cartella scritta
    con le maiuscole sbagliate rispetto al disco (raro: di solito è chi
    scrive la sessione, cioè il sistema operativo, a dare la cwd già nella
    grafia vera) non verrebbe riconosciuta; il sync la ripulirebbe comunque
    al giro dopo con la validazione piena.
    """
    if not os.path.exists(CONFIG):
        return [], set(), True
    try:
        with open(CONFIG, encoding="utf-8") as fh:
            testo = fh.read()
    except Exception:
        return [], set(), False
    try:
        cfg = json.loads(testo)
    except Exception:
        return [], set(), False
    if not isinstance(cfg, dict):
        return [], set(), False
    grezze_cartelle = cfg.get("cartelle_escluse") or []
    grezze_sessioni = cfg.get("sessioni_escluse") or []
    if not isinstance(grezze_cartelle, list) or not all(
            isinstance(c, str) for c in grezze_cartelle):
        return [], set(), False
    if not isinstance(grezze_sessioni, list) or not all(
            isinstance(s, str) for s in grezze_sessioni):
        return [], set(), False

    # Le stesse tre cartelle che esclusi.valida() protegge (HOME, la
    # cartella di Claude Code, quella di Plancia): stessi nomi di variabile
    # d'ambiente e stessi default di plancia/config.py, senza importarlo.
    home = os.path.expanduser("~")
    claude_dir = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(home, ".claude")
    try:
        protette = [_norma(os.path.realpath(p)) for p in (home, claude_dir, DATA)]
    except Exception:
        return [], set(), False

    cartelle = []
    for c in grezze_cartelle:
        try:
            assoluto = os.path.expanduser(c)
            if not os.path.isabs(assoluto):
                return [], set(), False
            p = _norma(os.path.realpath(assoluto))
        except Exception:
            return [], set(), False
        # esclusi._grafia_vera() controlla solo che ogni componente esista,
        # non che l'ultimo sia proprio una cartella: stessa cosa qui, con
        # os.path.exists e non os.path.isdir, o l'hook rifiuterebbe un
        # config.json che esclusi.valida() accetterebbe.
        if not os.path.exists(p):
            return [], set(), False
        if _P.dirname(p) == p:  # la radice ("/", "C:\\") non si esclude
            return [], set(), False
        if any(_dentro(prot, p) for prot in protette):
            return [], set(), False
        cartelle.append(p)

    for sid in grezze_sessioni:
        if not _ID_VALIDO.match(sid):
            return [], set(), False

    sessioni = set(s for s in grezze_sessioni if s)
    return cartelle, sessioni, True


def _config_con_nominati():
    """config.json nomina dei compartimenti (oltre a `predefinito`)? Una lettura
    e basta: senza compartimenti questo hook non importa il pacchetto e fa
    quello che ha sempre fatto. Una config che non si legge conta come "forse":
    `compartimenti_viste.attivo()` puo' avere ancora l'ultima copia valida."""
    try:
        with open(CONFIG, encoding="utf-8") as fh:
            cfg = json.load(fh)
    except FileNotFoundError:
        return False
    except Exception:
        return True
    if not isinstance(cfg, dict):
        return True
    comp = cfg.get("compartimenti")
    if comp is None:
        return False
    if not isinstance(comp, dict):
        return True
    return any(k != "predefinito" for k in comp)


def _carica_viste():
    """Il modulo plancia.compartimenti_viste, senza mettere ne' la radice del
    checkout ne' `bin/` sul sys.path (stesso metodo di bin/plancia-guardiano:
    un file `.py` messo accanto non deve rubare il posto a un modulo di
    sistema). Solleva se non si carica."""
    import importlib.util
    radice = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    cartella = os.path.join(radice, "plancia")
    spec = importlib.util.spec_from_file_location(
        "plancia", os.path.join(cartella, "__init__.py"),
        submodule_search_locations=[cartella])
    modulo = importlib.util.module_from_spec(spec)
    sys.modules["plancia"] = modulo
    spec.loader.exec_module(modulo)
    from plancia import compartimenti_viste
    return compartimenti_viste


def _escluso(cwd, session_id, cartelle, sessioni):
    """Stessa regola di plancia/esclusi.sessione_esclusa(): per id esplicito,
    o perché la cartella da cui la sessione è partita è esclusa (o sta sotto
    una cartella esclusa)."""
    if session_id and session_id in sessioni:
        return True
    if not cwd or not cartelle:
        return False
    try:
        p = _norma(os.path.realpath(os.path.expanduser(cwd)))
    except Exception:
        return False
    return any(_dentro(p, c) for c in cartelle)


# Le cartelle che contengono progetti ma non sono progetti. Una sessione aperta
# qui dentro lavora a distanza dentro le cartelle figlie senza esserci mai
# entrata: e' cosi' che si perdono le tracce, ed e' cosi' che il contenitore
# "Senza progetto" era arrivato a 162 sessioni.
#
# Nessun percorso scritto a mano: sono calcolati con la stessa regola di
# plancia/attribuzione.contenitori_avviso() (questo script non importa il
# pacchetto, quindi la regola vive in due posti; tools/prove/piattaforma-console-
# hook.py li confronta su una casa finta e fallisce se non sono d'accordo).
def _contenitori(casa=None):
    casa = casa or os.path.expanduser("~")
    fuori = []
    # ogni cartella di Google Drive ("Il mio Drive" dentro CloudStorage) e le
    # sue due cartelle di primo livello; `dev`, `Siti`, `dev/siti` sotto casa
    drive = sorted(glob.glob(os.path.join(
        casa, "Library", "CloudStorage", "GoogleDrive-*", "Il mio Drive")))
    if drive:
        fuori.append(drive[0])
    fuori += [os.path.join(casa, "dev"), os.path.join(casa, "Siti"),
              os.path.join(casa, "dev", "siti")]
    if drive:
        fuori += [os.path.join(drive[0], "Lavoro"), os.path.join(drive[0], "Personale")]
    # chi ne ha altri (un disco esterno, un'altra cartella) li scrive in
    # config.json, chiave "contenitori": una lista di percorsi. Una chiave
    # scritta male non e' un errore, e' come non averla: e' solo un avviso.
    try:
        with open(CONFIG, encoding="utf-8") as fh:
            extra = json.load(fh).get("contenitori")
    except Exception:
        extra = None
    if isinstance(extra, list):
        fuori += [os.path.expanduser(c) for c in extra if isinstance(c, str) and c.strip()]
    visti, elenco = set(), []
    for c in fuori:
        n = os.path.normpath(c)
        if n not in visti:
            visti.add(n)
            elenco.append(n)
    return elenco


def ancoraggio(cwd, filtro=None):
    """Dice a Claude se la sessione e' ancorata a un progetto o no.

    `filtro`, quando ci sono dei compartimenti (plancia/compartimenti_viste.py),
    e' una funzione percorso -> bool: i progetti legati a un percorso che il
    compartimento della sessione non vede non si nominano ne' si contano (senza,
    l'avviso di una sessione aperta in `~/dev` elencherebbe anche il progetto di
    un altro compartimento).

    Non tocca il filesystem: i percorsi noti li chiede al database, perche'
    elencare le cartelle dentro il Drive sveglia la sincronizzazione e
    l'avvio deve restare istantaneo.
    """
    if not cwd:
        return ""
    cwd = _norma(cwd)

    import sqlite3
    noti = {}
    con = sqlite3.connect(f"file:{DB}?mode=ro", uri=True, timeout=1.0)
    try:
        # Due fonti, non una: un progetto puo' essere legato a una cartella da un
        # repo con local_path oppure da un collegamento di tipo 'path'. Leggerne
        # una sola fa dire "cartella sconosciuta" su progetti che invece ci sono.
        righe = con.execute(
            "select r.local_path, p.key from repos r join projects p on p.id = r.project_id "
            "where r.local_path is not null and r.local_path != '' "
            "union "
            "select l.value, p.key from project_links l join projects p on p.id = l.project_id "
            "where l.kind = 'path'"
        ).fetchall()
        for percorso, chiave in righe:
            noti[_norma(percorso)] = chiave
    finally:
        con.close()
    if filtro is not None:
        noti = {k: v for k, v in noti.items() if filtro(k)}

    # Un contenitore non e' mai la casa di un progetto, per legge della radice:
    # si controlla prima, cosi' un contenitore registrato per sbaglio come
    # percorso di progetto non zittisce l'avviso (e' successo con ~/dev).
    contenitori = {_norma(c) for c in _contenitori()}
    if cwd in contenitori:
        figli = sorted({v for k, v in noti.items() if _dentro(k, cwd) and k != cwd})
        elenco = ("  Progetti registrati qui dentro: " + ", ".join(figli)) if figli else ""
        return (
            "\n\nATTENZIONE: questa sessione e' aperta in una cartella contenitore, "
            f"non dentro un progetto ({cwd}).\n"
            "  Da qui le schede dei file di un progetto NON si aprono (la radice della "
            "sessione e' questa cartella, e settings.json non conta) e ogni cd sposta "
            "solo la shell. Appena sai su quale progetto si lavora, PRIMA di scrivere "
            "qualsiasi cosa, chiama mcp__ccd_directory__change_directory con il percorso "
            "assoluto del progetto: la sessione si sposta li' e i file si aprono. Se non "
            "lo sai, chiediglielo. Per una seconda cartella oltre al progetto, "
            "mcp__ccd_directory__request_directory.\n" + elenco
        )

    # La corrispondenza piu' specifica vince: con `~/dev` registrato come
    # percorso di un progetto, `~/dev/stiva` risultava ancorata a quello invece
    # che a stiva. I contenitori non contano mai come percorso di progetto.
    candidati = [(percorso, chiave) for percorso, chiave in noti.items()
                 if percorso not in contenitori and _dentro(cwd, percorso)]
    if candidati:
        percorso, chiave = max(candidati, key=lambda pc: len(pc[0]))
        return f"\n\nSessione ancorata al progetto `{chiave}` ({percorso})."

    return (
        f"\n\nQuesta cartella non risulta legata a nessun progetto di Plancia ({cwd}). "
        "Prima di scrivere, cerca la scheda con `plancia` azione=projects; se non c'e', creala."
    )


def run():
    raw = ""
    try:
        if not sys.stdin.isatty():
            raw = sys.stdin.read()
    except Exception:
        pass
    try:
        payload = json.loads(raw) if raw.strip() else {}
    except Exception:
        payload = {}

    # `--prova` serve a vedere cosa restituirebbe senza mettere in coda una
    # sessione che non esiste. Senza, provare l'hook sporca l'archivio con una
    # sessione fantasma, e le statistiche cominciano a contare cose mai
    # successe.
    prova = "--prova" in sys.argv or "--dry-run" in sys.argv
    argomenti = [a for a in sys.argv[1:] if not a.startswith("-")]
    event = payload.get("hook_event_name") or (argomenti[0] if argomenti else "hook")
    record = {
        "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "event": event,
        "session_id": payload.get("session_id", ""),
        "cwd": payload.get("cwd") or "",
        "source": payload.get("source", ""),
    }
    try:
        cartelle, sessioni, valido = _cartelle_e_sessioni_escluse()
    except Exception:
        # Fail-closed anche qui, per lo stesso motivo del corpo della
        # funzione: un'eccezione imprevista non e' "niente escluso".
        cartelle, sessioni, valido = [], set(), False
    escluso = valido and _escluso(record["cwd"], record["session_id"], cartelle, sessioni)

    if not prova and valido and not escluso:
        try:
            os.makedirs(os.path.dirname(QUEUE), exist_ok=True)
            with open(QUEUE, "a", encoding="utf-8") as fh:
                fh.write(json.dumps(record, ensure_ascii=False) + "\n")
        except Exception:
            pass
    # Senza `valido` (config.json non si legge o non passa la validazione) o
    # con la sessione esclusa: niente in coda. Un config.json rotto non deve
    # MAI significare "scrivi tutto come se niente fosse escluso" — è
    # esattamente il contrario di quello che chi ha scritto
    # "cartelle_escluse" voleva.

    # Compartimenti: chi e' questa sessione. Se in config ce ne sono di nominati
    # e non si riesce a dirlo (il pacchetto non si carica, un'eccezione), la
    # sessione NON riceve il briefing: meglio il silenzio che il lavoro di un
    # altro compartimento.
    viste = ambito = visore = None
    comp_errore = False
    if event == "SessionStart":
        try:
            if _config_con_nominati():
                viste = _carica_viste()
                ambito = viste.attivo(DATA)
                if ambito is not None:
                    visore = viste.visore_da_payload(ambito, payload)
        except Exception:
            comp_errore = True

    if event == "SessionStart":
        try:
            if comp_errore or (ambito is not None and visore == viste.INCERTO):
                sorgente = None
            elif ambito is not None:
                # con i compartimenti attivi si legge SOLO il file del proprio
                # compartimento: il `briefing.md` di prima poteva non essere
                # separato
                sorgente = viste.file_briefing(DATA, visore)
                if not os.path.exists(sorgente):
                    # appena scritta la config con i compartimenti, prima di
                    # un sync o di una scrittura: il file per compartimento non
                    # c'e' ancora. Lo si genera qui (una volta) invece di
                    # lasciare la sessione senza briefing; se non riesce, silenzio
                    try:
                        from plancia import briefing as _briefing
                        _briefing.write_cache()
                    except Exception:
                        pass
            else:
                sorgente = BRIEFING
                if not os.path.exists(sorgente) and os.path.exists(
                        os.path.join(DATA, "plancia.db")):
                    # Con dei compartimenti attivi `briefing.md` non si scrive
                    # (e se c'era, si toglie): tolti i compartimenti dalla
                    # config il file manca, e lo si riscrive qui, subito,
                    # invece di aspettare il prossimo sync. Se non riesce,
                    # silenzio (com'era con il file mancante).
                    try:
                        if viste is None:
                            _carica_viste()
                        from plancia import briefing as _briefing
                        _briefing.write_cache()
                    except Exception:
                        pass
            if sorgente is None:
                text = ""
            else:
                with open(sorgente, encoding="utf-8") as fh:
                    text = fh.read().strip()
        except Exception:
            text = ""
        if len(text) > MAX_CONTEXT:
            text = text[:MAX_CONTEXT].rsplit("\n", 1)[0] + "\n…"
        # L'avviso si aggiunge dopo il taglio: e' la riga che non deve mai
        # sparire, ed e' proprio quella che un briefing lungo mangerebbe.
        # Una sessione esclusa (o una configurazione di cui non ci si può
        # fidare) non deve ricevere né l'ancoraggio né l'invito a creare una
        # scheda: prima di questa correzione, una sessione aperta in una
        # cartella privata riceveva comunque "questa cartella non risulta
        # legata a nessun progetto... se non c'è, creala", e un tool MCP
        # chiamato subito dopo scriveva davvero quella scheda.
        try:
            if not valido or comp_errore:
                pass
            elif escluso:
                text += "\n\nSessione privata: non registrare niente in Plancia."
            elif ambito is not None:
                if visore != viste.INCERTO:
                    text += ancoraggio(record["cwd"], lambda p: viste.percorso_visibile(
                        ambito, visore, p))
            else:
                text += ancoraggio(record["cwd"])
        except Exception:
            pass
        if text.strip():
            sys.stdout.write(json.dumps({"hookSpecificOutput": {
                "hookEventName": "SessionStart",
                "additionalContext": text,
            }}, ensure_ascii=False) + "\n")


try:
    run()
except Exception:
    pass
sys.exit(0)
